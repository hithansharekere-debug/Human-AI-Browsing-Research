# ==============================================================================
# DATA SECURITY & REPRODUCIBILITY RESTRICTIONS
# ==============================================================================
# RAW DATASET IS STRICTLY EXTERNAL TO THIS REPO.
# No raw packet captures, archives, or telemetry dumps inside repository.
*.pcap
*.pcapng
*.cap
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# Intermediate runtime data and caches
data/
raw_data/
raw/
processed/
temp/
tmp/
*.tmp
*.log

# Sensitive egress artifacts and large analysis dumps
# Retain directory structure via .gitkeep but ignore large generated output
results/*
!results/.gitkeep
!results/*.csv
!results/*.json
!results/*.md
output/*
!output/.gitkeep
figures/*
!figures/.gitkeep
!figures/*.png

# Exclude any temporary intermediate parquet or CSV dumps containing egress details
*.parquet
*.feather
*.sqlite
*.db

# Participant-level source data, ledgers, and corrections
sessions.csv
label_corrections.csv
schedule.csv
SHA256SUMS.txt
FREEZE.json

# Chrome NetLogs and ground-truth artifacts
*.netlog
netlog.json
*netlog*
ground_truth/
*ground_truth*

# Scratch directory
scratch/

